{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "event",
        "condition",
        "action",
        "command",
        "hook",
        "content_type"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "parameter_schema": {
      "type": "object"
    },
    "result_schema": {
      "type": "object"
    },
    "owner_module": {
      "type": "string",
      "minLength": 1
    },
    "allowed_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "run",
          "level",
          "encounter",
          "entity",
          "execution"
        ]
      },
      "minItems": 1
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ordinary",
          "attack",
          "before_damage_commit"
        ]
      },
      "minItems": 1
    },
    "timing": {
      "type": "string",
      "enum": [
        "instant",
        "sustained",
        "composite"
      ]
    },
    "cancellation": {
      "type": "string",
      "minLength": 1
    },
    "side_effects": {
      "type": "string",
      "minLength": 1
    },
    "hook_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "emitted_events": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "use": {
      "type": "string",
      "enum": [
        "production",
        "contract_fixture"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "version",
    "parameter_schema",
    "result_schema",
    "owner_module",
    "allowed_scopes",
    "contexts",
    "timing",
    "cancellation",
    "side_effects",
    "hook_permissions",
    "emitted_events",
    "error_codes",
    "use"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:echo:contracts:0.1.0:capability_descriptor"
}
