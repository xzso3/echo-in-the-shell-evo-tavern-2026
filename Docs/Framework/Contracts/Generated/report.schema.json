{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_version": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "content_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependency_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "package_id",
          "sha256"
        ]
      },
      "minItems": 0
    },
    "framework_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "framework_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "tested_commit": {
      "type": "string",
      "minLength": 1
    },
    "catalog_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "runner_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host",
        "runtime",
        "os"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run",
              "blocked"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0.0
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "content_id": {
                  "type": "string"
                },
                "field_path": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "file",
                "content_id",
                "field_path",
                "message"
              ]
            },
            "minItems": 0
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "case_id",
          "status",
          "duration_ms",
          "expected",
          "actual",
          "diagnostics",
          "artifacts"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "report_version",
    "content_digest",
    "dependency_digests",
    "framework_version",
    "framework_digest",
    "tested_commit",
    "catalog_digest",
    "schema_digest",
    "runner_version",
    "environment",
    "seed",
    "cases"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:echo:contracts:0.1.0:report"
}
