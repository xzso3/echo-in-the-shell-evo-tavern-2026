{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*\\.\\.)(?!.*\\/(?![\\s\\S]))[a-z][a-z0-9_.-]*:resource/[a-z][a-z0-9_./-]*(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "enum": [
              "sprite",
              "texture",
              "audio",
              "text",
              "font"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|(?![\\s\\S])))(?!.*\\\\)[a-zA-Z0-9_./-]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "source_path",
          "sha256",
          "license"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "resources"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:echo:contracts:0.1.0:resources"
}
